{
  "manifest_version": 3,
  "name": "YouTube SEO Booster by Hmna-Tech",
  "version": "1.0",
  "description": "Comprehensive SEO tools for YouTube creators to optimize videos and grow their channel",
  "author": "Faisal - Hmna-Tech",
  "action": {
    "default_icon": {
      "16": "icons/16/icon16.png",
      "48": "icons/48/icon48.png",
      "128": "icons/128/icon128.png"
    }
  },
  "icons": {
    "16": "icons/16/icon16.png",
    "48": "icons/48/icon48.png",
    "128": "icons/128/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["modern_styles.css", "styles.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://www.googleapis.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "chart.js",
        "fullpage.html",
        "fullpage.js",
        "js/*",
        "css/*",
        "icons/*"
      ],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
